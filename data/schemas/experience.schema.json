{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Experiência",
  "description": "Itens da timeline (empregos, formação, voluntariado, cursos), na ordem em que aparecem. O currículo em PDF agrupa os itens pelo \"type\".",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/item" }
    }
  },
  "definitions": {
    "item": {
      "type": "object",
      "required": ["type", "title", "start"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "description": "Seção do currículo em que o item entra: \"work\" (Experiência), \"education\" (Formação), \"volunteering\" (Voluntariado) ou \"courses\" (só no site).",
          "enum": ["work", "education", "volunteering", "courses"]
        },
        "title": {
          "description": "Cargo, curso ou título do bloco.",
          "$ref": "common.schema.json#/definitions/text"
        },
        "organization": {
          "description": "Empresa ou instituição. Opcional.",
          "$ref": "common.schema.json#/definitions/text"
        },
        "start": {
          "description": "Início: \"2025-07\" ou \"2022\".",
          "$ref": "common.schema.json#/definitions/period"
        },
        "end": {
          "description": "Fim, no mesmo formato. Sem este campo, o site exibe \"Presente\".",
          "$ref": "common.schema.json#/definitions/period"
        },
        "highlights": {
          "type": "array",
          "description": "Tópicos da lista do card (e do currículo, para \"work\" e \"education\").",
          "items": { "$ref": "common.schema.json#/definitions/text" }
        }
      },
      "defaultSnippets": [
        {
          "label": "Nova experiência",
          "description": "Item da timeline",
          "body": {
            "type": "${1|work,education,volunteering,courses|}",
            "title": "${2:Cargo}",
            "organization": "${3:Empresa}",
            "start": "${4:2026-01}",
            "highlights": [
              { "pt": "${5:O que você fez}", "en": "${6:What you did}" }
            ]
          }
        }
      ]
    }
  }
}
