{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Projetos",
  "description": "Seção de projetos (destaque e índice) e o modal de detalhes.",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "items": {
      "type": "array",
      "description": "Projetos em ordem de relevância: o primeiro sai em destaque, com imagem e ficha técnica; os demais formam o índice, nesta ordem.",
      "items": { "$ref": "#/definitions/project" }
    }
  },
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "project": {
      "type": "object",
      "required": ["id", "title", "tags", "summary", "links"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Identificador único do projeto (minúsculas e hífens).",
          "$ref": "#/definitions/slug"
        },
        "cv": {
          "type": "integer",
          "minimum": 1,
          "description": "Posição do projeto no currículo em PDF (1 = primeiro). Sem este campo, o projeto não entra no currículo."
        },
        "title": {
          "description": "Título no site e no modal.",
          "$ref": "common.schema.json#/definitions/text"
        },
        "image": {
          "description": "Imagem real do projeto (diagrama ou tela), exibida no destaque e no modal. Opcional: o índice nunca mostra imagens.",
          "$ref": "common.schema.json#/definitions/imagePath"
        },
        "status": {
          "description": "Opcional: \"in-progress\" exibe \"Em andamento\" no site e no modal.",
          "enum": ["in-progress"]
        },
        "tags": {
          "type": "array",
          "description": "Tecnologias, exibidas na coluna \"Stack\" e no currículo.",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "context": {
          "description": "Origem do projeto, exibida na coluna \"Contexto\", ex.: \"Disciplina de Banco de Dados\" ou \"Pessoal\". Opcional: sem ele, a coluna fica vazia.",
          "$ref": "common.schema.json#/definitions/text"
        },
        "summary": {
          "description": "Descrição curta exibida no site.",
          "$ref": "common.schema.json#/definitions/text"
        },
        "cvSummary": {
          "description": "Frase de uma linha (até ~105 caracteres) usada no currículo em PDF. Opcional: sem ela, o currículo usa o \"summary\".",
          "$ref": "common.schema.json#/definitions/text"
        },
        "details": {
          "type": "object",
          "description": "Conteúdo do modal \"Detalhes\". Opcional: sem ele, o modal mostra o resumo.",
          "additionalProperties": false,
          "properties": {
            "intro": {
              "description": "Parágrafo de abertura.",
              "$ref": "common.schema.json#/definitions/text"
            },
            "features": {
              "type": "array",
              "description": "Lista exibida após \"Recursos incluem:\".",
              "items": { "$ref": "common.schema.json#/definitions/text" }
            },
            "outro": {
              "description": "Parágrafo de fechamento.",
              "$ref": "common.schema.json#/definitions/text"
            }
          }
        },
        "links": {
          "type": "object",
          "description": "Links exibidos no site e no modal.",
          "additionalProperties": false,
          "properties": {
            "github": {
              "description": "Repositório no GitHub.",
              "$ref": "common.schema.json#/definitions/url"
            },
            "demo": {
              "description": "Versão online do projeto.",
              "$ref": "common.schema.json#/definitions/url"
            }
          }
        }
      },
      "defaultSnippets": [
        {
          "label": "Novo projeto",
          "description": "Esqueleto completo de um projeto (site + modal)",
          "body": {
            "id": "${1:meu-projeto}",
            "title": { "pt": "${2:Título}", "en": "${3:Title}" },
            "tags": ["${4:Java}"],
            "context": { "pt": "${5:Pessoal}", "en": "${6:Personal}" },
            "summary": { "pt": "${7:Resumo curto.}", "en": "${8:Short summary.}" },
            "details": {
              "intro": { "pt": "${9:Parágrafo de abertura do modal.}", "en": "${10:Modal opening paragraph.}" },
              "features": [
                { "pt": "${11:Recurso}", "en": "${12:Feature}" }
              ],
              "outro": { "pt": "${13:Parágrafo de fechamento.}", "en": "${14:Closing paragraph.}" }
            },
            "links": { "github": "https://github.com/danisommer/${15:repositorio}" }
          }
        }
      ]
    }
  }
}
